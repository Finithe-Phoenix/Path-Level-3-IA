  "voiceBuild": "f7cbcf40d8bb508fd26c8e33ad4ea5ecde5a26198c96fe6f36d8ab9202d1cd0e",
  "paceBuild": "7401bb66df87d34d295e594f27f1948629fe6b034343242cf16d462d5a4408fb",
  "delivery": {
    "targetWordsPerMinute": 146,
    "inputWordsPerMinute": 158.72,
    "tempo": 0.94193704,
    "outputWordsPerMinute": 146.01
  },
  "audioSha256": "5a52c1112f4b2b7d9ecda85bd4ac483773bbd4264c84f9fdbddcd197c9176dc0",
  "captionsSha256": "3ebdcdcc675ec2112556299ad9443cfdb18bd3b67ae60a0d71c9e55ed3a433a3",
  "scenes": [
    {
      "id": "purpose",
      "scriptSha256": "193d7a995e60c393dc8558a4cb8335b2f91a652ee252e20ef4a33f4a5e62cdfb",
      "durationFrames": 594,
      "cues": [
        {
          "start": 0.466,
          "end": 4.978,
          "text": "Suppose your agent needs the acceptance\ncriteria from a training issue."
        },
        {
          "start": 5.058,
          "end": 7.234,
          "text": "How does that issue get into the\nsession?"
        },
        {
          "start": 7.324,
          "end": 8.368,
          "text": "Follow the arrows."
        },
        {
          "start": 9.019,
          "end": 11.752,
          "text": "The client connects to an M C P server,"
        },
        {
          "start": 11.805,
          "end": 14.858,
          "text": "and the server offers one read-only\ntool."
        },
        {
          "start": 14.911,
          "end": 19.179,
          "text": "When the tool is called, it reads a\nsynthetic issue fixture and sends a"
        },
        {
          "start": 19.232,
          "end": 20.083,
          "text": "result back."
        },
        {
          "start": 20.78,
          "end": 23.307,
          "text": "Let's check the contract before calling\nit."
        }
      ]
    },
    {
      "id": "scope",
      "scriptSha256": "7e0c88eb8abff6039d06e564beb0379680f21dba5d80cde9f8d3dcd8a8e2fd87",
      "durationFrames": 580,
      "cues": [
        {
          "start": 0.444,
          "end": 2.939,
          "text": "Open the approved integration record."
        },
        {
          "start": 3.018,
          "end": 7.429,
          "text": "It names a server, training issues, and\na tool, get training issue."
        },
        {
          "start": 7.482,
          "end": 10.888,
          "text": "The tool takes a number and can read\norders issues from the fixture."
        },
        {
          "start": 11.566,
          "end": 14.91,
          "text": "Look at the operation and the data scope\ntogether."
        },
        {
          "start": 15.016,
          "end": 18.493,
          "text": "If the workspace owner has provided the\nlab as a recording,"
        },
        {
          "start": 18.546,
          "end": 22.378,
          "text": "the same record tells you which action\nthe captured result represents."
        }
      ]
    },
    {
      "id": "config",
      "scriptSha256": "bd28359a1c47a5154d2f6c02e23ec5c4e8fcf36802a6d616c22923c5ef0aecfd",
      "durationFrames": 591,
      "cues": [
        {
          "start": 0.466,
          "end": 3.571,
          "text": "Next, inspect how the approved client\nconnects."
        },
        {
          "start": 3.624,
          "end": 8.136,
          "text": "The real screen depends on whether\nyou're in Claude Code or OpenCode and on"
        },
        {
          "start": 8.163,
          "end": 9.354,
          "text": "the installed build."
        },
        {
          "start": 10.054,
          "end": 15.07,
          "text": "Find the configured server identity and\nscope where the workspace exposes them."
        },
        {
          "start": 15.123,
          "end": 17.512,
          "text": "The values on this screen are fixtures."
        },
        {
          "start": 17.591,
          "end": 21.228,
          "text": "Use the approved connection as\nconfigured, and keep the lab on this"
        },
        {
          "start": 21.281,
          "end": 22.859,
          "text": "synthetic data boundary."
        }
      ]
    },
    {
      "id": "call",
      "scriptSha256": "aff23e8cc94ceb1c80e095ce5a20efd46dff1f029633cd1f39cd7c9c4a140f65",
      "durationFrames": 581,
      "cues": [
        {
          "start": 0.444,
          "end": 4.372,
          "text": "Ask for issue seventeen and its\nacceptance criteria."
        },
        {
          "start": 4.451,
          "end": 8.486,
          "text": "In this example, the client proposes get\ntraining issue with issue number"
        },
        {
          "start": 8.539,
          "end": 9.263,
          "text": "seventeen."
        },
        {
          "start": 9.903,
          "end": 12.079,
          "text": "Check the operation and the number."
        },
        {
          "start": 12.132,
          "end": 15.848,
          "text": "They should match the request you made,\nand the tool should be approved for that"
        },
        {
          "start": 15.901,
          "end": 17.069,
          "text": "input."
        },
        {
          "start": 17.149,
          "end": 20.864,
          "text": "This is the evidence you want before\nresponding to any confirmation prompt"
        },
        {
          "start": 20.944,
          "end": 22.419,
          "text": "shown by your workspace."
        }
      ]
    },
    {
      "id": "result",
      "scriptSha256": "78c0aa64af48838e36499308caadebf908fe86af58a94339d2b4a4ebe3d1bcda",
      "durationFrames": 605,
      "cues": [
        {
          "start": 0.413,
          "end": 2.828,
          "text": "The tool returns two requirements."
        },
        {
          "start": 2.908,
          "end": 5.137,
          "text": "Positive integers are accepted."
        },
        {
          "start": 5.243,
          "end": 8.243,
          "text": "Zero and negative integers are rejected."
        },
        {
          "start": 8.322,
          "end": 11.619,
          "text": "Now look at the agent's summary and\ncheck that it carries both."
        },
        {
          "start": 12.281,
          "end": 17.377,
          "text": "If it only says to reject zero, the\nnegative case was lost in the summary."
        },
        {
          "start": 17.457,
          "end": 21.624,
          "text": "Correct the summary against the actual\nissue text so the next stage can use"
        },
        {
          "start": 21.677,
          "end": 23.37,
          "text": "both acceptance criteria."
        }
      ]
    },
    {
      "id": "boundary",
      "scriptSha256": "f562ee41a1bcb712b6aad1fb721f695dd93b44b59f3c665d685f1b8fb8954424",
      "durationFrames": 589,
      "cues": [
        {
          "start": 0.444,
          "end": 5.035,
          "text": "Imagine the next proposed action is to\npost the summary to a pull request."
        },
        {
          "start": 5.115,
          "end": 7.185,
          "text": "Catch that change in scope."
        },
        {
          "start": 7.265,
          "end": 10.985,
          "text": "Reading issue seventeen and writing a\ncomment are different operations."
        },
        {
          "start": 11.658,
          "end": 14.8,
          "text": "For this lab, save the summary in the\nsession."
        },
        {
          "start": 14.88,
          "end": 18.914,
          "text": "In the actual review workflow, the\nauthorized author or reviewer decides"
        },
        {
          "start": 18.967,
          "end": 22.741,
          "text": "what to post using their own account and\nGitHub CLI."
        }
      ]
    },
    {
      "id": "record",
      "scriptSha256": "720737224ace13384ccf1cccf7bf7f9fbd3b373f70ba625bf59923c2dd81555f",
      "durationFrames": 543,
      "cues": [
        {
          "start": 0.462,
          "end": 4.618,
          "text": "Finish with a small record: the approved\nserver, the tool and number,"
        },
        {
          "start": 4.804,
          "end": 7.299,
          "text": "and the two criteria you verified."
        },
        {
          "start": 7.378,
          "end": 10.93,
          "text": "A teammate should see exactly what was\nread and what matched the source."
        },
        {
          "start": 11.592,
          "end": 15.069,
          "text": "That is the simplest useful M C P\nworkflow:"
        },
        {
          "start": 15.149,
          "end": 18.785,
          "text": "one authorized tool call that brings\nevidence into the task,"
        },
        {
          "start": 18.838,
          "end": 20.711,
          "text": "with a boundary that you can explain."
        }
      ]
    }
  ]
}
