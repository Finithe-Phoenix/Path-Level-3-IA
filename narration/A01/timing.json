  "paceBuild": "a4f5f4a46deeb92352fdbe57b05b6a1cb03d90efdce1370eb664f8885a836253",
  "delivery": {
    "targetWordsPerMinute": 149,
    "inputWordsPerMinute": 174.73,
    "tempo": 0.87332534,
    "outputWordsPerMinute": 149.0
  },
  "audioSha256": "84587c1b1c2888c0483e5b41fc229517206800bce0f002691180c07886d8bc2e",
  "captionsSha256": "4ad696a88346cbc69b0f1d6ca712c13337b66f6f8f4e2910822f822fda821499",
  "scenes": [
    {
      "id": "lab",
      "scriptSha256": "21497dd645e8ad420a91a8bcdbf3fff3f6ceae6ce6b7860fbd3f0ac2f976616a",
      "durationFrames": 575,
      "cues": [
        {
          "start": 0.269,
          "end": 3.218,
          "text": "Before we launch either agent, look at\nthe workspace badge."
        },
        {
          "start": 3.654,
          "end": 8.091,
          "text": "It says Corporate G C P, and the\nterminal is open in that workspace."
        },
        {
          "start": 8.55,
          "end": 13.53,
          "text": "That's the operating boundary for this\nseries. The repository in the demo is a"
        },
        {
          "start": 13.53,
          "end": 14.88,
          "text": "synthetic order service."
        },
        {
          "start": 15.276,
          "end": 20.226,
          "text": "We'll start with a read-only task, so by\nthe end you can compare exactly what the"
        },
        {
          "start": 20.226,
          "end": 22.539,
          "text": "agent explored with what changed on\ndisk."
        }
      ]
    },
    {
      "id": "checkout",
      "scriptSha256": "6a0297cfdd5138739006598392fefa6f8f3cc6e09968750d9e55dc2cd3d3ab78",
      "durationFrames": 562,
      "cues": [
        {
          "start": 0.269,
          "end": 4.216,
          "text": "In the terminal, run P W D, then Git\nstatus and Git rev-parse."
        },
        {
          "start": 4.675,
          "end": 9.61,
          "text": "The path ends in training-orders. Status\ndisplays the lab branch and no file"
        },
        {
          "start": 9.61,
          "end": 12.803,
          "text": "entries beneath it, so we have a clean\nstarting point."
        },
        {
          "start": 13.216,
          "end": 15.997,
          "text": "The short commit is twenty-seven E four\nA B one."
        },
        {
          "start": 16.319,
          "end": 20.912,
          "text": "Copy the commit from your own terminal.\nYou can use it later to reproduce the"
        },
        {
          "start": 20.912,
          "end": 21.858,
          "text": "same inspection."
        }
      ]
    },
    {
      "id": "clients",
      "scriptSha256": "f54a651851fcd54499e7913bf9913d0842de4732a59fa7e93c7dcd028573498b",
      "durationFrames": 596,
      "cues": [
        {
          "start": 0.315,
          "end": 4.801,
          "text": "Now ask each client for its version.\nThis is much faster than guessing from"
        },
        {
          "start": 4.801,
          "end": 6.715,
          "text": "the menu or from a video."
        },
        {
          "start": 7.15,
          "end": 12.164,
          "text": "Record the two values your workspace\nreports. If one command is missing,"
        },
        {
          "start": 12.428,
          "end": 16.271,
          "text": "you can finish the first inspection with\nthe other approved client."
        },
        {
          "start": 16.833,
          "end": 21.348,
          "text": "Use those version numbers when you look\nup configuration, model selection,"
        },
        {
          "start": 21.773,
          "end": 23.462,
          "text": "or skill discovery later."
        }
      ]
    },
    {
      "id": "model",
      "scriptSha256": "1a1c37b4d3189b9a64e72fd971ecfff8b3c63a1ff8d8f96dda0996a1e89f495d",
      "durationFrames": 687,
      "cues": [
        {
          "start": 0.339,
          "end": 3.693,
          "text": "Open the existing session's model\nselector or status view."
        },
        {
          "start": 4.395,
          "end": 7.286,
          "text": "Suppose the client shows a friendly\nmodel label."
        },
        {
          "start": 7.722,
          "end": 11.631,
          "text": "Record the resolved identifier when the\nworkspace makes it visible,"
        },
        {
          "start": 11.988,
          "end": 15.025,
          "text": "since the same label can point to\ndifferent versions."
        },
        {
          "start": 15.609,
          "end": 19.931,
          "text": "Then check the configured provider. The\nterminal runs in G C P,"
        },
        {
          "start": 20.538,
          "end": 24.79,
          "text": "while the configured provider determines\nwhere model requests are processed."
        },
        {
          "start": 25.204,
          "end": 27.308,
          "text": "Keep both facts in the session record."
        }
      ]
    },
    {
      "id": "access",
      "scriptSha256": "e3f8b9916cfcb1a0f8a3c70263d1514fccd0c36714e6480cb8dbdd8cdf57c308",
      "durationFrames": 606,
      "cues": [
        {
          "start": 0.292,
          "end": 3.011,
          "text": "Here is the effective policy for our\nexample:"
        },
        {
          "start": 3.505,
          "end": 8.88,
          "text": "reading the training files is allowed,\nand edits or unit-test runs ask for"
        },
        {
          "start": 8.88,
          "end": 9.78,
          "text": "confirmation."
        },
        {
          "start": 10.125,
          "end": 12.705,
          "text": "Look up the effective policy for your\nown session."
        },
        {
          "start": 13.269,
          "end": 15.336,
          "text": "This matters even for a simple prompt."
        },
        {
          "start": 15.703,
          "end": 18.053,
          "text": "You can tell an agent to inspect a file,"
        },
        {
          "start": 18.34,
          "end": 22.507,
          "text": "but a proposed command is still a\nseparate action that needs to fit the"
        },
        {
          "start": 22.507,
          "end": 23.693,
          "text": "session's permissions."
        }
      ]
    },
    {
      "id": "request",
      "scriptSha256": "f68e0da1face9e30ba1470d26c996aee361059ab11ae4b0e30f3455228dd0a52",
      "durationFrames": 548,
      "cues": [
        {
          "start": 0.338,
          "end": 4.96,
          "text": "Ask the agent for two paths and one\nconcrete case: the quantity validator,"
        },
        {
          "start": 5.133,
          "end": 7.713,
          "text": "its test file, and the test for zero."
        },
        {
          "start": 8.162,
          "end": 9.731,
          "text": "Watch it inspect the checkout."
        },
        {
          "start": 10.232,
          "end": 15.02,
          "text": "The example points to the validator in\norders slash quantity dot P Y and to"
        },
        {
          "start": 15.02,
          "end": 17.24,
          "text": "test rejects zero in the test suite."
        },
        {
          "start": 17.59,
          "end": 21.352,
          "text": "Those names give us a simple way to\nconfirm the answer ourselves."
        }
      ]
    },
    {
      "id": "verify",
      "scriptSha256": "de0c63ad31789ea5ee90528c588fa9a3739e404cede3367ccff00c909778c2bc",
      "durationFrames": 594,
      "cues": [
        {
          "start": 0.361,
          "end": 4.734,
          "text": "Open the reported validator and the\ntest. Check that the test actually"
        },
        {
          "start": 4.734,
          "end": 8.626,
          "text": "passes zero to the validator and expects\na rejection."
        },
        {
          "start": 9.187,
          "end": 11.453,
          "text": "Then run the branch and commit checks\nagain."
        },
        {
          "start": 11.819,
          "end": 15.663,
          "text": "In the demonstration the branch header\nis still the only status line,"
        },
        {
          "start": 16.019,
          "end": 17.637,
          "text": "and the commit is unchanged."
        },
        {
          "start": 18.049,
          "end": 20.776,
          "text": "That gives us direct evidence about the\ncheckout,"
        },
        {
          "start": 21.133,
          "end": 23.123,
          "text": "independent of the agent's summary."
        }
      ]
    },
    {
      "id": "close",
      "scriptSha256": "3b5caec3434ce7bc29cc46da04006950eb8b5d2758d63c5cbb7e7768df118f03",
      "durationFrames": 558,
      "cues": [
        {
          "start": 0.338,
          "end": 5.21,
          "text": "Finish by saving the workspace, commit,\nclient version, model, provider,"
        },
        {
          "start": 5.45,
          "end": 7.962,
          "text": "and permissions next to the two verified\npaths."
        },
        {
          "start": 8.351,
          "end": 10.936,
          "text": "That's the minimum useful record for the\nnext lab."
        },
        {
          "start": 11.327,
          "end": 15.61,
          "text": "You can now start a session with a clear\nboundary, ask a small question,"
        },
        {
          "start": 15.898,
          "end": 17.08,
          "text": "and verify the answer."
        },
        {
          "start": 17.516,
          "end": 21.775,
          "text": "Next, we'll check how both clients pick\nup the same repository convention."
        }
      ]
    }
  ]
}
